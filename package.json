{
  "name": "airiks-resort",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "vite dev",
    "dev:api": "node api/server.mjs",
    "build": "vite build && tsc --noEmit",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "lint:styles": "stylelint \"src/**/*.{css,scss}\" --allow-empty-input",
    "lint:styles:fix": "stylelint \"src/**/*.{css,scss}\" --fix --allow-empty-input",
    "check": "npm run typecheck && npm run lint && npm run lint:styles && npm run test:coverage -- --runInBand && npm run betterer:ci && npm run build && npm run test:e2e",
    "betterer": "betterer",
    "betterer:ci": "betterer ci"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.3.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-start": "^1.168.49",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-hook-form-mui": "^9.0.1"
  },
  "devDependencies": {
    "@betterer/betterer": "^6.0.0-alpha.1",
    "@betterer/cli": "^6.0.0-alpha.1",
    "@betterer/constraints": "^6.0.0-alpha.1",
    "@betterer/regexp": "^6.0.0-alpha.1",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.0",
    "@playwright/test": "^1.63.0",
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-jest": "^29.16.5",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.11.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^30.5.0",
    "jest-fetch-mock": "^4.2.0",
    "nitro": "^3.0.260610-beta",
    "sass": "^1.103.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2"
  }
}
